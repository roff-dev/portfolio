---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Prompt from '../components/Prompt.astro';
import { winPath } from '../lib/shell';

const commands = [
  { cmd: 'cd ~', href: '/', label: 'the home page' },
  { cmd: 'ls projects', href: '/#projects', label: 'my projects' },
  { cmd: 'cat about', href: '/about/', label: 'about me' },
];
---
<Base title="Page not found" description="That page doesn't exist. Go to the home page, my projects or the about page instead." noindex>
  <section class="nf" aria-labelledby="nf-title">
    <Terminal title="kieron@portfolio:~" raised>
      <div class="nf__body">
        <Prompt path="~" cmd="cd">
          <Fragment slot="mac">cd <span data-path>that-page</span></Fragment>
          <Fragment slot="win">cd <span data-path>that-page</span></Fragment>
        </Prompt>
        <p class="nf__err">
          <span class="os-mac">bash: cd: <span data-path>that-page</span>: No such file or directory</span>
          <span class="os-win">Set-Location: Cannot find path '{winPath('~/')}<span data-path>that-page</span>' because it does not exist.</span>
        </p>
        <h1 id="nf-title">That page doesn't exist.</h1>
        <p class="nf__try">Try one of these instead.</p>
        <ul class="nf__cmds">
          {commands.map(({ cmd, href, label }) => (
            <li>
              <a class="nf__cmd" href={href}>
                <span class="nf__run" aria-hidden="true">{cmd}</span>
                <span class="nf__note"><span aria-hidden="true"># </span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
        <Prompt class="nf__idle" aria-hidden="true" path="~" cmd="">
          <Fragment slot="mac"><span class="nf__caret"></span></Fragment>
          <Fragment slot="win"><span class="nf__caret"></span></Fragment>
        </Prompt>
      </div>
    </Terminal>
  </section>
</Base>

<script>
  // The same page answers every missing address, so show the one that was asked for
  let path = location.pathname.replace(/^\/+|\/+$/g, '');
  try { path = decodeURIComponent(path); } catch { /* keep it encoded */ }
  if (path.length > 60) path = `${path.slice(0, 59)}…`;
  if (path) document.querySelectorAll('[data-path]').forEach((el) => { el.textContent = path; });
</script>

<style>
  /* Centre the window in the space above the footer */
  :global(main:has(> .nf)) { display: flex; flex-direction: column; }
  .nf {
    display: grid;
    place-items: center;
    flex: 1;
    padding: 24px var(--gutter) 48px;
  }
  .nf :global(.term) { max-width: 720px; }

  .nf__body { padding: 20px clamp(16px, 4vw, 28px) 24px; font: 16px/1.5 var(--font-term); }
  .nf__err { margin: 0 0 28px; color: var(--error); overflow-wrap: anywhere; }

  h1 { margin: 0; color: var(--heading); font: 700 clamp(22px, 5vw, 28px)/1.25 var(--font-term); }
  .nf__try { margin: 6px 0 16px; color: var(--text-2); }

  .nf__cmds { display: grid; gap: 2px; margin: 0 0 20px; padding: 0; list-style: none; }
  .nf__cmd {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 14px;
    min-height: 44px;
    padding: 10px 0;
    color: var(--text);
    text-decoration: none;
  }
  .nf__cmd::before { content: var(--prompt-mark); margin-right: -4px; color: var(--muted); }
  .nf__run { border-bottom: 1px dashed var(--accent); }
  .nf__note { color: var(--muted); }
  .nf__cmd:hover .nf__run { color: var(--accent-hover); border-bottom-style: solid; }
  .nf__cmd:hover .nf__note { color: var(--text-2); }

  .nf__idle { margin: 0; }
  .nf__caret {
    display: inline-block;
    width: .55em;
    height: 1.05em;
    vertical-align: -.2em;
    background: var(--text);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .nf__caret { animation: none; }
  }
</style>
