---
import Base from '../../layouts/Base.astro';
import SnippetBrowser from '../../components/SnippetBrowser.astro';
---
<Base title="Code" description="Code from my projects, each explained: the problem, why I wrote it that way and the detail to notice. Search by language, project or anything in the code.">
  <section class="code-page" aria-labelledby="code-title">
    <h1 id="code-title" class="sr-only">Code from my projects</h1>
    <SnippetBrowser />
  </section>
</Base>

<style>
  .code-page { padding: 24px var(--gutter) 48px; }
  /* The library fits the screen above the taskbar, with the same margin above and below */
  @media (min-width: 768px) and (min-height: 560px) {
    .code-page { padding-bottom: 24px; }
  }
</style>
