---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---
<Base>
  <section class="screen" aria-label="Introduction">
    <Terminal title="console@kieron-oates:~/portfolio" raised>
      <h1 class="stub">Kieron Oates, web developer</h1>
    </Terminal>
  </section>
  <section class="screen" id="projects" aria-label="Projects">
    <Terminal title="kieron@portfolio:~/projects"><p class="stub">Projects</p></Terminal>
  </section>
</Base>

<style>
  .screen { min-height: 100vh; min-height: calc(100svh - var(--bar-h)); display: grid; place-items: center; padding: 24px var(--gutter); }
  .stub { margin: 0; padding: 20px; font-size: 18px; font-weight: 400; }
</style>
