---
import Base from './Base.astro';
import Terminal from '../components/Terminal.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** The file the page pretends to be, e.g. privacy.md */
    filename: string;
    /** Last changed, as YYYY-MM-DD */
    updated: string;
  };
}

const { title, description, filename, updated } = Astro.props.frontmatter;
const slug = filename.replace(/\.md$/, '');
---
<Base title={title} description={description}>
  <section class="legal" aria-labelledby="legal-title">
    <Terminal title={`kieron@portfolio:~/${slug}`}>
      <div class="legal__body">
        <p class="prompt" aria-hidden="true"><span class="prompt__user">kieron@portfolio</span>:<span class="prompt__path">~</span>$ cat {filename}</p>
        <h1 id="legal-title">{title}</h1>
        <div class="legal__text">
          <slot />
        </div>
        <p class="prompt legal__log" aria-hidden="true"><span class="prompt__user">kieron@portfolio</span>:<span class="prompt__path">~</span>$ git log -1 --format=%cd --date=short {filename}</p>
        <p class="legal__date">
          <span class="sr-only">Last updated </span><time datetime={updated}>{updated}</time>
        </p>
      </div>
    </Terminal>
  </section>
</Base>

<style>
  .legal { max-width: 900px; padding: 24px var(--gutter) 48px; }
  @media (min-width: 768px) {
    .legal { padding-top: 48px; }
  }

  .legal__body { padding: 20px clamp(16px, 4vw, 32px) 28px; font: 14px/1.5 var(--font-term); }

  h1 { margin: 0 0 24px; color: var(--heading); font: 700 clamp(24px, 5vw, 32px)/1.2 var(--font-term); }
  h1::before { content: "# " / ""; color: var(--muted); font-weight: 400; }

  /* Reading text in the UI face; the terminal face stays for the commands around it */
  .legal__text { max-width: 62ch; color: var(--text); font: 16px/1.7 var(--font-ui); }
  .legal__text :global(h2) { margin: 32px 0 8px; color: var(--heading); font: 700 18px/1.3 var(--font-term); }
  .legal__text :global(h2::before) { content: "## " / ""; color: var(--muted); font-weight: 400; }
  .legal__text :global(p) { margin: 0 0 14px; }
  .legal__text :global(ul) { margin: 0 0 14px; padding-left: 0; list-style: none; }
  .legal__text :global(li) { padding-left: 2ch; text-indent: -2ch; }
  .legal__text :global(li::before) { content: "+ " / ""; color: var(--muted); }
  .legal__text :global(a) { text-decoration-style: dashed; text-underline-offset: 3px; }
  .legal__text :global(a:hover) { text-decoration-style: solid; }

  .legal__log { margin-top: 36px; }
  .legal__date { margin: 0; color: var(--text-2); }
</style>
