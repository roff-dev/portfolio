---
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
// Only downloaded when the Windows theme uses it
import '@fontsource/cascadia-mono/400.css';
import '@fontsource/cascadia-mono/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import dmMono400 from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import Background from '../components/Background.astro';
import Taskbar from '../components/Taskbar.astro';
import Footer from '../components/Footer.astro';
import PageSnap from '../components/PageSnap.astro';
import { site } from '../site';

interface Props {
  /** Page name; the home page leaves it out */
  title?: string;
  description?: string;
  /** Keep the page out of search results (the not-found page has no address of its own) */
  noindex?: boolean;
  /** Each scroll moves a whole screen: sections marked .snap-page snap into place */
  snap?: boolean;
}

const { title, description = site.description, noindex = false, snap = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en-GB" class:list={[{ snap }]} data-theme="mac">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- The desktop before anything paints: the saved choice, or the device's light or dark setting -->
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'mac' && theme !== 'windows') theme = matchMedia('(prefers-color-scheme: light)').matches ? 'windows' : 'mac';
        document.documentElement.dataset.theme = theme;
        if (theme === 'windows') document.addEventListener('DOMContentLoaded', () => document.querySelector('meta[name="theme-color"]').content = '#f3f3f3');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#202020" />
    <link rel="preload" href={dmMono400} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A terminal window reading: npm install Web Developer --skills, beside my pixel-art logo." />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Background />
    <Taskbar />
    <div class="content">
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    {snap && <PageSnap />}
    {import.meta.env.PROD && site.analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}></script>
    )}
  </body>
</html>
