---
import Terminal from './Terminal.astro';
---
<section class="hero snap-page" aria-label="Introduction">
  <Terminal class="hero__term" title="console@kieron-oates:~/portfolio" raised>
    <h1 class="hero__line">
      <span class="sr-only">Kieron Oates, web developer</span>
      <span aria-hidden="true"><span class="os-mac">$ </span><span class="os-win">PS&gt; </span><span data-typed></span><span class="hero__caret"></span></span>
    </h1>
  </Terminal>
  <a class="hero__next" href="#projects" aria-label="Skip to projects">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </a>
</section>

<script>
  import { startTyping } from '../scripts/typing';

  startTyping(document.querySelector<HTMLElement>('.hero [data-typed]')!);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: var(--screen-full);
    /* No side padding: the widths below are of the whole content area, as before */
    padding: 24px 0 calc(88px + var(--dock-room));
  }

  /* The old widths: 90% of the content area, 70% from 768px, 55% from 992px */
  .hero :global(.hero__term) { width: 90%; }
  @media (min-width: 768px) { .hero :global(.hero__term) { width: 70%; } }
  @media (min-width: 992px) { .hero :global(.hero__term) { width: 55%; } }

  /* The old terminal was 400px tall whatever the text, with its 36px bar */
  .hero__line {
    margin: 0;
    padding: 20px;
    min-height: 364px;
    font-size: clamp(22px, 8vw, 30px);
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .hero__line { padding-top: 10px; font-size: clamp(30px, 3.4vw, 40px); }
  }

  .hero__line :global(b) { font-weight: 700; }
  .hero__line :global(.t-key) { color: var(--keyword); }
  .hero__line :global(.t-mute) { color: var(--muted); }

  /* The old Typed.js cursor: a thin bar */
  .hero__caret {
    display: inline-block;
    width: .07em;
    height: 1em;
    margin-left: .1em;
    vertical-align: -.12em;
    background: var(--text);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .hero__next {
    position: absolute;
    bottom: calc(15px + var(--dock-room));
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 60px;
    border-radius: 10px;
    color: var(--text-strong);
  }
  .hero__next svg { width: 50px; height: 50px; transition: scale .3s ease; }
  @media (hover: hover) {
    .hero__next:hover { background: linear-gradient(to bottom, var(--surface), transparent 50%, var(--surface)); }
    .hero__next:hover svg { scale: 1.1; }
  }

  /* Windows: a frosted button with a thin Fluent-style chevron, like the panels and caption buttons around it */
  :global([data-theme="windows"]) .hero__next {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(0, 0, 0, .08);
    border-radius: 8px;
    background: rgba(249, 249, 249, .82);
    backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: var(--shadow-term);
    color: var(--text);
  }
  :global([data-theme="windows"]) .hero__next svg { width: 20px; height: 20px; stroke-width: 1.6; }
  @media (hover: hover) {
    :global([data-theme="windows"]) .hero__next:hover { background: #fff; }
    :global([data-theme="windows"]) .hero__next:hover svg { scale: 1; translate: 0 2px; transition: translate .2s ease; }
  }

  /* Short screens (a phone on its side, a foldable's cover screen): type sized by height, no arrow */
  @media (max-height: 520px) {
    .hero { padding-bottom: calc(24px + var(--dock-room)); }
    .hero__line { min-height: 0; font-size: clamp(18px, 5.5vh, 30px); }
    .hero__next { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__caret { animation: none; }
  }
</style>
