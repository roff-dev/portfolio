---
import fs from 'node:fs';
import path from 'node:path';
import { Picture } from 'astro:assets';
import { portfolioProjects } from '../lib/projects';

const projects = await portfolioProjects();
const count = projects.length;

/** "4.9 MB" for a file in public/, so a download link says how big it is */
function fileSize(publicPath: string) {
  const bytes = fs.statSync(path.join(process.cwd(), 'public', publicPath)).size;
  return bytes >= 1e6 ? `${(bytes / 1e6).toFixed(1)} MB` : `${Math.round(bytes / 1e3)} KB`;
}
---
<section class="projects snap-page" id="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="sr-only">Projects</h2>
  <div class="win term" data-window>
    <div class="term__bar">
      <span class="term__lights" aria-hidden="true" data-static-lights>
        <span class="term__light" style="--c: var(--light-red)"></span>
        <span class="term__light" style="--c: var(--light-yellow)"></span>
        <span class="term__light" style="--c: var(--light-green)"></span>
      </span>
      <span class="term__lights" data-lights hidden>
        <button type="button" class="term__light" style="--c: var(--light-red)" data-close aria-label="Close full screen" disabled></button>
        <button type="button" class="term__light" style="--c: var(--light-yellow)" data-min aria-label="Minimise projects" aria-expanded="true" aria-controls="win-body"></button>
        <button type="button" class="term__light" style="--c: var(--light-green)" data-max aria-label="Expand projects to full screen" aria-pressed="false"></button>
      </span>
      <span class="term__title" data-title>kieron@portfolio:~/projects</span>
    </div>

    <div class="win__body" id="win-body">
      <div class="win__inner">
        <div class="tabs" role="tablist" aria-label="Projects" data-tabs hidden>
          {projects.map(({ id }, i) => (
            <button type="button" class="tab" role="tab" id={`tab-${id}`} aria-controls={id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{id}</button>
          ))}
        </div>

        <div class="panels">
          {projects.map(({ id, data }) => (
            <article class="panel" id={id} aria-labelledby={`name-${id}`}>
              <div class="panel__grid">
                <figure class="shot">
                  <Picture src={data.image.src} alt={data.image.alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1200px) 560px, (min-width: 900px) 45vw, 92vw" loading="lazy" decoding="async" />
                </figure>
                <div class="panel__text">
                  <p class="prompt">
                    <span class="prompt__user">kieron@portfolio</span>:<span class="prompt__path"><span class="prompt__long">~/projects/</span><span class="prompt__short">~/</span>{id}</span>$ cat README.md
                  </p>
                  <h3 class="panel__name" id={`name-${id}`}>{data.name}</h3>
                  <p class="panel__desc">{data.description}</p>
                  <p class="panel__label">Built with</p>
                  <ul class="stack">
                    {data.stack.map((item) => <li>{item}</li>)}
                  </ul>
                  <ul class="cmds">
                    {data.links.live && <li><a class="cmd" href={data.links.live}><span>Open {data.name}</span></a></li>}
                    {data.links.repo && <li><a class="cmd" href={data.links.repo}><span>Read the code on GitHub</span></a></li>}
                    {data.links.pdf && <li><a class="cmd" href={data.links.pdf} download><span>Download the dissertation</span> <small>(PDF, {fileSize(data.links.pdf)})</small></a></li>}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
  <p class="dock" data-dock hidden>
    {count} {count === 1 ? 'project' : 'projects'} minimised <button type="button" data-restore>restore</button>
  </p>
</section>

<script>
  import { startProjectWindow } from '../scripts/project-window';

  startProjectWindow(document.querySelector<HTMLElement>('#projects')!);
</script>

<style>
  .projects {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    min-height: 100vh;
    min-height: calc(100svh - var(--bar-h));
    padding: 24px var(--gutter);
  }

  .win {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    max-width: 1180px;
    view-transition-name: projects-window;
  }
  /* Room to fit the window to the screen: the panel scrolls inside it instead */
  @media (min-width: 768px) and (min-height: 600px) {
    .win[data-ready] { max-height: calc(100svh - var(--bar-h) - 48px); }
  }

  .term__light:not(:disabled) { cursor: pointer; }
  .term__light:disabled { opacity: .45; cursor: default; }
  .term__lights[hidden] { display: none; }
  /* The lights are 12px dots; the buttons around them are a comfortable size to press */
  [data-lights] { gap: 0; margin-inline: -6px; }
  [data-lights] .term__light { box-sizing: content-box; width: 12px; height: 12px; padding: 0; border: 10px solid transparent; background-clip: padding-box; }
  [data-lights] .term__light:focus-visible { outline-offset: -8px; }

  /* Minimising folds the body away; it becomes inert once folded */
  .win__body {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    flex: 1 1 auto;
    min-height: 0;
    transition: grid-template-rows .35s ease;
  }
  .win__inner { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .win.is-min .win__body { grid-template-rows: minmax(0, 0fr); }
  .win.is-min .win__inner { visibility: hidden; transition: visibility 0s .35s; }

  .tabs {
    flex-shrink: 0;
    display: flex;
    gap: 2px;
    padding: 0 8px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    background: var(--term-header);
  }
  .tabs[hidden] { display: none; }
  .tab {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 6px 6px 0 0;
    background: transparent;
    color: var(--text-2);
    font: 14px/1 var(--font-term);
    scroll-snap-align: start;
    cursor: pointer;
  }
  .tab[aria-selected="true"] { background: var(--term-body); color: var(--text); }
  .tab:hover { color: var(--text); }
  .tab:focus-visible { outline-offset: -3px; }

  .panels { flex: 1 1 auto; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--term-border) transparent; }
  .panel { padding: 20px 16px 28px; }
  .panel + .panel { border-top: 1px solid var(--term-border); }
  .win[data-ready] .panel + .panel { border-top: 0; }
  .panel[hidden] { display: none; }
  .win[data-ready] .panel:not([hidden]) { animation: panel-in .15s ease; }
  @keyframes panel-in { from { opacity: 0; } }
  .panel:focus-visible { outline-offset: -4px; }

  .panel__grid { display: grid; gap: 20px; }
  .shot {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--term-border);
    border-radius: 6px;
    background: var(--surface);
  }
  .shot :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .prompt { font-size: 14px; }
  .prompt__short { display: none; }
  .panel__name { margin: 0 0 12px; color: var(--heading); font-size: clamp(22px, 5cqi, 30px); font-weight: 400; line-height: 1.2; }
  .panel__desc { margin: 0 0 18px; max-width: 62ch; font-size: 16px; line-height: 1.65; }
  .panel__label { margin: 0 0 6px; color: var(--muted); font-size: 14px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 18px; padding: 0; list-style: none; color: var(--text-2); font-size: 14px; }
  .stack li::before { content: "+ "; color: var(--prompt-user); }
  .cmds { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .cmd { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; min-height: 44px; color: var(--text); font-size: 15px; text-decoration: none; }
  .cmd::before { content: "$"; color: var(--muted); }
  .cmd span { border-bottom: 1px dashed var(--accent); }
  .cmd small { color: var(--muted); font-size: 13px; }
  .cmd:hover span { color: var(--accent-hover); border-bottom-style: solid; }

  @container (max-width: 420px) {
    .prompt__long { display: none; }
    .prompt__short { display: inline; }
  }
  @container (min-width: 820px) {
    .panel { padding: 28px 30px 32px; }
    .panel__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; gap: 32px; }
  }

  /* Full screen: fills the content area beside the sidebar, or the whole screen on a phone */
  .win.is-max { position: fixed; z-index: 30; inset: 0; width: auto; max-width: none; max-height: none; border-radius: 0; }
  @media (min-width: 768px) and (min-height: 560px) {
    .win.is-max { inset: 12px 12px 12px calc(var(--nav-w) + 12px); border-radius: var(--radius-term); }
  }

  .dock { margin: 14px 0 0; color: var(--text-2); font: 14px var(--font-term); }
  .dock[hidden] { display: none; }
  .dock button { min-height: 44px; padding: 0 6px; border: 0; background: none; color: var(--accent); font: inherit; text-decoration: underline dashed; cursor: pointer; }
  .dock button:hover { color: var(--accent-hover); }

  @media (prefers-reduced-motion: reduce) {
    .win__body, .win.is-min .win__inner { transition: none; }
    .win[data-ready] .panel:not([hidden]) { animation: none; }
  }
</style>
