---
import { winTitle } from '../lib/shell';

interface Props {
  /** The macOS title, e.g. kieron@portfolio:~/code; Windows shows its path in a tab */
  title: string;
  /** Windows draws no tab of its own: the projects window puts its project tabs there instead */
  tab?: boolean;
  /** Marks the macOS title for a script to update */
  live?: boolean;
}

const { title, tab = true, live = false } = Astro.props;
---
<!-- A window's title bar as each desktop draws it. macOS: the traffic lights and a centred title. Windows
     Terminal: a tab with the shell's icon, and minimise, maximise and close on the right. -->
<div class="term__bar">
  <span class="term__lights os-mac" aria-hidden="true">
    <span class="term__light" style="--c: var(--light-red)"></span>
    <span class="term__light" style="--c: var(--light-yellow)"></span>
    <span class="term__light" style="--c: var(--light-green)"></span>
  </span>
  <span class="term__title os-mac" data-title={live ? '' : undefined}>{title.split(/(?<=:)/).map((part, i) => [i > 0 && <wbr />, part])}</span>
  {tab && (
    <span class="term__tab os-win">
      <svg class="term__ps" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" rx="3" /><path d="m4 5 3 3-3 3M8.5 11h3.5" /></svg>
      <span>{winTitle(title)}</span>
    </span>
  )}
  <span class="term__caption os-win" aria-hidden="true">
    <svg viewBox="0 0 10 10"><path d="M0 5.5h10" /></svg>
    <svg viewBox="0 0 10 10"><rect x=".5" y=".5" width="9" height="9" rx="1.5" /></svg>
    <svg viewBox="0 0 10 10"><path d="m.5.5 9 9m0-9-9 9" /></svg>
  </span>
</div>

<style is:global>
  .term__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 36px;
    padding: 0 12px;
    background: var(--term-header);
    border-bottom: 1px solid var(--term-border);
  }
  .term__lights { display: flex; gap: 8px; }
  .term__light { width: 12px; height: 12px; border: 0; padding: 0; border-radius: 50%; background: var(--c); }
  /* The title stays centred on the window, not on the space beside the lights, and wraps rather than hiding the path */
  .term__title {
    flex: 1;
    min-width: 0;
    margin-right: 56px;
    padding-block: 8px;
    text-align: center;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* Windows Terminal: the tab rises from the bar into the window's body, and the caption buttons sit top right */
  [data-theme="windows"] .term__bar { align-items: stretch; gap: 0; min-height: 40px; padding: 0 0 0 8px; border-bottom: 0; }
  .term__tab {
    align-self: flex-end;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: min(320px, 70%);
    min-height: 32px;
    padding: 6px 12px;
    border-radius: 8px 8px 0 0;
    background: var(--term-body);
    color: var(--text);
    font: 12px/1.3 var(--font-ui);
  }
  .term__tab span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .term__ps { flex: none; width: 16px; height: 16px; }
  .term__ps rect { fill: #012456; }
  .term__ps path { fill: none; stroke: #fff; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .term__caption { display: flex; margin-left: auto; }
  .term__caption svg { box-sizing: content-box; width: 10px; height: 10px; padding: 11px 18px; fill: none; stroke: var(--text-2); stroke-width: 1; }
</style>
