---
import { site } from '../site';
import { SOCIAL_ICONS } from '../lib/icons';
import { portfolioProjects } from '../lib/projects';

const path = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/code/', label: 'Code' },
];

// The dock: each project's own icon, opening its tab in the projects window or its site in a new tab
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/icons/*.svg', { eager: true });
const dock = (await portfolioProjects()).map(({ id, data }) => {
  const icon = icons[`../assets/projects/icons/${id}.svg`];
  if (!icon) throw new Error(`No dock icon for ${id}: add src/assets/projects/icons/${id}.svg`);
  return { id, name: data.name, icon: icon.default.src, external: data.links.live ?? data.links.pdf };
});
---
<!-- The desktop's own navigation, laid out by each theme from the same markup, so the keyboard order never
     changes. macOS: a menu bar across the top (the logo, the pages, the tray) and the projects in a floating dock.
     Windows: one taskbar along the bottom, with the logo as the start button and the tray on the right. -->
<header class="taskbar">
  <a class="start" href="/" aria-current={path === '/' ? 'page' : undefined}>
    <img src="/logo.png" alt="Kieron Oates, home" width="43" height="43" />
  </a>

  <div class="taskbar__middle">
    <nav class="pages" aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <span class="taskbar__divider" aria-hidden="true"></span>
    <nav class="dock" aria-label="Projects">
      <ul>
        {dock.map(({ id, name, icon, external }) => (
          <li class="dock__item">
            <a class="dock__app" href={`/#${id}`} data-dock-app={id}>
              <img src={icon} alt="" width="48" height="48" />
              <span class="dock__name">{name}</span>
            </a>
            {external && (
              <a class="dock__out" href={external} target="_blank" rel="noopener" aria-label={`Open ${name} in a new tab`}>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="tray">
    <li>
      <button type="button" class="theme" data-theme-toggle aria-pressed="false">
        <svg class="os-mac" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
        <svg class="os-win" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        <span class="sr-only">Windows light theme</span>
      </button>
    </li>
    <li>
      <a href={site.social.linkedin} aria-label="LinkedIn" rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={SOCIAL_ICONS.linkedin} /></svg>
      </a>
    </li>
    <li>
      <a href={site.social.github} aria-label="GitHub" rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={SOCIAL_ICONS.github} /></svg>
      </a>
    </li>
  </ul>
</header>

<script>
  import { currentTheme, setTheme, type Theme } from '../scripts/theme';

  const bar = document.querySelector<HTMLElement>('.taskbar')!;

  // The theme switch: pressed means the Windows (light) desktop is on
  const toggle = bar.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const show = (theme: Theme) => {
    toggle.setAttribute('aria-pressed', String(theme === 'windows'));
    toggle.title = theme === 'windows' ? 'Switch to macOS (dark)' : 'Switch to Windows (light)';
  };
  show(currentTheme());
  toggle.addEventListener('click', () => setTheme(currentTheme() === 'windows' ? 'mac' : 'windows'));
  document.addEventListener('themechange', (event) => show((event as CustomEvent<Theme>).detail));

  // Escape hides the dock's name labels (they show on hover and focus otherwise) until the pointer or focus moves on
  addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && bar.matches(':hover, :focus-within')) bar.classList.add('is-quiet');
  });
  const wake = () => bar.classList.remove('is-quiet');
  bar.addEventListener('pointerover', wake);
  bar.addEventListener('focusin', wake);
</script>

<style>
  /* ---------- Shared ---------- */
  .taskbar {
    position: fixed;
    z-index: 20;
    display: grid;
    align-items: center;
    gap: 4px;
    padding-inline: max(8px, env(safe-area-inset-left)) max(8px, env(safe-area-inset-right));
  }
  /* The bar's glass is drawn behind it rather than on it: a blur on the bar itself would trap the floating dock
     inside it, since a filtered element becomes the box its fixed children are placed in */
  .taskbar::before { content: ""; position: absolute; inset: 0; z-index: -1; }
  .taskbar ul { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  .taskbar__middle { display: flex; align-items: center; gap: 12px; min-width: 0; }

  .start { justify-self: start; display: grid; place-items: center; }
  .start img { image-rendering: pixelated; transition: filter .6s ease, transform .6s ease; }

  .pages a { position: relative; display: grid; place-items: center; color: var(--text-strong); font-weight: 500; text-decoration: none; }

  .dock__item { position: relative; }
  .dock__app { position: relative; display: block; }
  .dock__app img { display: block; transform-origin: 50% 100%; transition: scale .2s ease, translate .2s ease; }
  .dock__app:focus-visible { outline-offset: 3px; }

  /* The project's name above its icon, on hover or keyboard focus */
  .dock__name {
    position: absolute;
    left: 50%;
    translate: -50% 4px;
    padding: 4px 9px;
    border: 1px solid var(--term-border);
    border-radius: 6px;
    background: var(--term-header);
    color: var(--text);
    font: 13px/1.3 var(--font-ui);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity .15s ease, translate .15s ease;
  }
  .dock__item:hover .dock__name,
  .dock__app:focus-visible .dock__name { opacity: 1; translate: -50% 0; }
  .taskbar.is-quiet .dock__name { opacity: 0; }

  /* Open the site itself in a new tab: a badge on the icon's corner */
  .dock__out {
    position: absolute;
    top: -9px;
    right: -9px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--term-border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    opacity: 0;
    transition: opacity .15s ease, translate .2s ease;
  }
  .dock__out svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .dock__item:hover .dock__out,
  .dock__out:focus-visible { opacity: 1; }
  .dock__out:hover { background: var(--surface-raised); color: var(--text-strong); }

  .tray a, .theme { display: grid; place-items: center; border: 0; background: none; color: var(--text-strong); cursor: pointer; }
  .tray svg { width: 18px; height: 18px; fill: currentColor; }
  .theme svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  @media (hover: hover) {
    .tray a[aria-label="LinkedIn"]:hover { color: #0077b5; }
  }

  /* ---------- macOS: the menu bar across the top, and the dock floating above the bottom ---------- */
  .taskbar { inset: 0 0 auto; height: var(--chrome-top); grid-template-columns: auto 1fr auto; }
  .taskbar::before {
    background: rgba(24, 24, 24, .62);
    backdrop-filter: blur(24px) saturate(1.6);
    border-bottom: 1px solid rgba(255, 255, 255, .08);
    box-shadow: 0 1px 14px rgba(0, 0, 0, .25);
  }
  .start { width: 36px; height: 32px; border-radius: 6px; }
  .start img { width: 26px; height: 26px; }
  .start:hover img { filter: drop-shadow(0 0 6px rgba(50, 50, 50, .6)); transform: scale(1.05) translateY(-1px); }

  /* The pages, by name, with the old nav's hover (a line drawing in from each corner); the page you're on is
     highlighted, like the open file in the code tree */
  .pages a { min-height: 32px; padding: 0 10px; border-radius: 6px; font-size: 14px; letter-spacing: -1px; }
  .pages a::before,
  .pages a::after { content: ""; position: absolute; width: 0; height: 2px; background: var(--muted); transition: width .3s ease; }
  .pages a::before { top: 2px; left: 0; }
  .pages a::after { bottom: 2px; right: 0; }
  @media (hover: hover) {
    .pages a:not([aria-current="page"]):hover::before,
    .pages a:not([aria-current="page"]):hover::after { width: 100%; }
  }
  .pages a[aria-current="page"] { background: var(--surface-raised); }

  .taskbar__divider { display: none; }

  .dock {
    position: fixed;
    left: 50%;
    bottom: calc(8px + env(safe-area-inset-bottom, 0px));
    translate: -50% 0;
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 22px;
    background: rgba(40, 40, 40, .48);
    backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 10px 30px rgba(0, 0, 0, .35);
  }
  .dock ul { gap: 10px; }
  .dock__app, .dock__app img { border-radius: 12px; }
  .dock__app img { width: 48px; height: 48px; }
  /* Under the pointer an icon swells and its neighbours a little, rising out of the dock */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(html:not([data-theme="windows"])) .dock__item:hover .dock__app img { scale: 1.45; translate: 0 -10px; }
    :global(html:not([data-theme="windows"])) .dock__item:hover + .dock__item .dock__app img,
    :global(html:not([data-theme="windows"])) .dock__item:has(+ .dock__item:hover) .dock__app img { scale: 1.2; translate: 0 -5px; }
    :global(html:not([data-theme="windows"])) .dock__item:hover .dock__out { translate: 11px -32px; }
  }
  .dock__name { bottom: calc(100% + 40px); }
  /* A dot under the project that's open in the projects window, as under a running app */
  .dock__app[aria-current="true"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 4px;
    height: 4px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--text-2);
  }

  .tray { justify-self: end; gap: 2px; }
  .tray a, .theme { width: 36px; height: 32px; border-radius: 6px; }
  @media (hover: hover) {
    .tray a:hover, .theme:hover { background: rgba(255, 255, 255, .12); }
  }

  /* ---------- Windows 11: one taskbar along the bottom ---------- */
  :global([data-theme="windows"]) .taskbar { inset: auto 0 0; height: var(--bar-bottom); padding-bottom: env(safe-area-inset-bottom); grid-template-columns: 1fr auto 1fr; }
  :global([data-theme="windows"]) .taskbar::before {
    background: rgba(243, 243, 243, .86);
    backdrop-filter: blur(30px) saturate(1.8);
    border-top: 1px solid rgba(0, 0, 0, .08);
    border-bottom: 0;
    box-shadow: none;
  }
  :global([data-theme="windows"]) .start { width: 44px; height: 44px; border-radius: 4px; }
  :global([data-theme="windows"]) .start img { width: 30px; height: 30px; }
  :global([data-theme="windows"]) .start:hover { background: rgba(0, 0, 0, .05); }
  :global([data-theme="windows"]) .start:hover img { filter: none; transform: none; }
  :global([data-theme="windows"]) .taskbar__middle { justify-content: center; gap: 8px; }

  /* Taskbar buttons: a soft tile on hover, and a stronger one for the page you're on */
  :global([data-theme="windows"]) .pages ul { gap: 2px; }
  :global([data-theme="windows"]) .pages a { min-height: 44px; padding: 0 12px; border-radius: 4px; font-size: 15px; letter-spacing: 0; }
  :global([data-theme="windows"]) .pages a::before,
  :global([data-theme="windows"]) .pages a::after { display: none; }
  @media (hover: hover) {
    :global([data-theme="windows"]) .pages a:hover { background: rgba(0, 0, 0, .05); }
  }
  :global([data-theme="windows"]) .pages a[aria-current="page"] { background: var(--surface-raised); }

  :global([data-theme="windows"]) .taskbar__divider { display: block; width: 1px; height: 24px; background: rgba(0, 0, 0, .14); }

  /* The projects as pinned apps: no swelling, a tile on hover, and the blue pill under the open one */
  :global([data-theme="windows"]) .dock { position: static; translate: none; padding: 0; border: 0; border-radius: 0; background: none; backdrop-filter: none; box-shadow: none; }
  :global([data-theme="windows"]) .dock ul { gap: 2px; }
  :global([data-theme="windows"]) .dock__app { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 4px; }
  :global([data-theme="windows"]) .dock__app img { width: 28px; height: 28px; border-radius: 6px; }
  @media (hover: hover) {
    :global([data-theme="windows"]) .dock__item:hover .dock__app { background: rgba(0, 0, 0, .05); }
  }
  :global([data-theme="windows"]) .dock__app[aria-current="true"]::after { bottom: 3px; width: 16px; height: 3px; border-radius: 2px; background: var(--accent); }
  :global([data-theme="windows"]) .dock__name { bottom: calc(100% + 14px); border-color: rgba(0, 0, 0, .1); background: var(--surface); font-size: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, .12); }

  :global([data-theme="windows"]) .tray { gap: 2px; }
  :global([data-theme="windows"]) .tray a,
  :global([data-theme="windows"]) .theme { width: 40px; height: 40px; border-radius: 4px; }
  @media (hover: hover) {
    :global([data-theme="windows"]) .tray a:hover,
    :global([data-theme="windows"]) .theme:hover { background: rgba(0, 0, 0, .05); }
  }

  /* ---------- Phones: the pages and the tray only; the projects window's tabs list the projects ---------- */
  @media (max-width: 767px) {
    .taskbar__divider, .dock { display: none !important; }
    /* The pages centre in the room between the logo and the tray, which is wider than the logo */
    :global([data-theme="windows"]) .taskbar { grid-template-columns: auto minmax(0, 1fr) auto; }
    :global([data-theme="windows"]) .pages a { padding: 0 8px; }
    :global([data-theme="windows"]) .tray a,
    :global([data-theme="windows"]) .theme { width: 36px; }
  }
  /* The narrowest phones: everything a little tighter, in either theme */
  @media (max-width: 380px) {
    .taskbar { gap: 0; }
    .start, :global([data-theme="windows"]) .start { width: 40px; }
    .pages a, :global([data-theme="windows"]) .pages a { padding: 0 3px; font-size: 14px; }
    :global([data-theme="windows"]) .pages ul { gap: 0; }
    .tray a, .theme, :global([data-theme="windows"]) .tray a, :global([data-theme="windows"]) .theme { width: 32px; }
  }
</style>
