---
import { site } from '../site';
import { portfolioProjects } from '../lib/projects';

const path = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/code/', label: 'Code' },
];

// The dock beside Projects: each project's own icon, opening its tab here or its site in a new tab
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/icons/*.svg', { eager: true });
const dock = (await portfolioProjects()).map(({ id, data }) => {
  const icon = icons[`../assets/projects/icons/${id}.svg`];
  if (!icon) throw new Error(`No dock icon for ${id}: add src/assets/projects/icons/${id}.svg`);
  return { id, name: data.name, icon: icon.default.src, external: data.links.live ?? data.links.pdf };
});
---
<header class="nav">
  <a class="nav__logo" href="/" aria-current={path === '/' ? 'page' : undefined}>
    <img src="/logo.png" alt="Kieron Oates, home" width="43" height="43" />
  </a>
  <nav class="nav__menu" aria-label="Main">
    <ul class="nav__links">
      {links.map(({ href, label }) => (
        <li class:list={{ nav__projects: label === 'Projects' }} data-dock-host={label === 'Projects' ? '' : undefined}>
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          {label === 'Projects' && (
            <ul class="dock" aria-label="Projects">
              {dock.map(({ id, name, icon, external }) => (
                <li class="dock__item">
                  <a class="dock__app" href={`/#${id}`}>
                    <img src={icon} alt="" width="40" height="40" />
                    <span class="dock__name">{name}</span>
                  </a>
                  {external && (
                    <a class="dock__out" href={external} target="_blank" rel="noopener" aria-label={`Open ${name} in a new tab`}>
                      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <ul class="nav__social">
    <li>
      <a href={site.social.linkedin} aria-label="LinkedIn" rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.6 8.65 22 11.3 22 14.7V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21h-4V9Z" /></svg>
      </a>
    </li>
    <li>
      <a href={site.social.github} aria-label="GitHub" rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
    </li>
  </ul>
</header>

<script>
  // Escape puts the dock away (it stays shown on hover and focus otherwise), until the pointer or focus leaves
  const host = document.querySelector<HTMLElement>('[data-dock-host]')!;
  addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || host.classList.contains('is-closed') || !host.matches(':hover, :focus-within')) return;
    host.classList.add('is-closed');
    if (host.matches(':focus-within')) host.querySelector<HTMLElement>(':scope > a')!.focus();
  });
  const reopen = () => host.classList.remove('is-closed');
  host.addEventListener('pointerleave', reopen);
  host.addEventListener('focusout', (event) => {
    if (!host.contains(event.relatedTarget as Node)) reopen();
  });
</script>

<style>
  /* Top bar on phones and short screens; the established 200px sidebar when there is room */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: var(--bar-h);
    padding: 8px max(12px, env(safe-area-inset-right)) 8px max(12px, env(safe-area-inset-left));
    background: var(--surface);
  }
  .nav__menu { display: flex; align-items: center; margin-left: auto; }
  .nav ul { display: flex; margin: 0; padding: 0; list-style: none; }

  .nav__logo { display: grid; place-items: center; flex: 0 0 auto; min-width: 44px; min-height: 44px; }
  .nav__logo img { width: 43px; height: 43px; image-rendering: pixelated; transition: filter .6s ease, transform .6s ease; }
  .nav__logo:hover img { filter: drop-shadow(0 0 8px rgba(50, 50, 50, .6)); transform: scale(1.05) translateY(-2px); }

  .nav__links > li > a {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 0 7px;
    color: var(--text-strong);
    font-weight: 500;
    letter-spacing: -1px;
    text-decoration: none;
    transition: letter-spacing .3s ease;
  }
  /* The old hover: a line draws in from each corner while the letters spread */
  .nav__links > li > a::before,
  .nav__links > li > a::after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    background: var(--surface-raised);
    transition: width .3s ease;
  }
  .nav__links > li > a::before { top: 0; left: 0; }
  .nav__links > li > a::after { bottom: 0; right: 0; }
  @media (hover: hover) {
    .nav__links > li > a:hover { letter-spacing: 2px; }
    .nav__links > li > a:hover::before,
    .nav__links > li > a:hover::after { width: 100%; }
  }
  .nav__links > li > a[aria-current="page"]::before,
  .nav__links > li > a[aria-current="page"]::after { width: 100%; background: var(--term-border); }

  .nav__social a { display: grid; place-items: center; width: 44px; height: 44px; color: var(--text-strong); }
  .nav__social svg { width: 20px; height: 20px; fill: currentColor; }
  @media (hover: hover) {
    .nav__social a[aria-label="LinkedIn"]:hover { color: #0077b5; }
    .nav__social a[aria-label="GitHub"]:hover { color: var(--text-2); }
  }

  /* The dock only fits beside the sidebar */
  .nav__links .dock { display: none; }

  @media (min-width: 768px) and (min-height: 560px) {
    /* Logo at the top, links in the middle of the screen, social icons at the bottom */
    .nav {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--nav-w);
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      justify-items: center;
      gap: 24px;
      padding: 28px 0 20px;
    }
    .nav__logo { align-self: start; }
    .nav__logo img { width: 129px; height: 129px; }
    .nav__menu { flex-direction: column; width: 100%; margin: 0; }
    .nav__links { flex-direction: column; width: 100%; }
    .nav__links > li > a { min-height: 52px; padding: 0 20px; font-size: 1.05rem; }
    .nav__social { align-self: end; gap: 4px; }

    .nav__projects { position: relative; }
    .nav__links .dock {
      position: absolute;
      top: 50%;
      left: calc(100% + 12px);
      display: flex;
      width: max-content;
      gap: 10px;
      padding: 10px;
      border: 1px solid var(--term-border);
      border-radius: 16px;
      background: var(--term-header);
      box-shadow: var(--shadow-term);
      opacity: 0;
      visibility: hidden;
      translate: -8px -50%;
      /* A short grace before it hides, so the pointer can cross the gap */
      transition: opacity .2s ease .15s, translate .2s ease .15s, visibility 0s .35s;
    }
    /* Bridges the gap between the sidebar and the dock, so moving across doesn't close it */
    .dock::before { content: ""; position: absolute; inset: 0 100% 0 -14px; }
    .nav__projects:is(:hover, :focus-within):not(.is-closed) .dock {
      opacity: 1;
      visibility: visible;
      translate: 0 -50%;
      transition: opacity .2s ease, translate .2s ease, visibility 0s;
    }

    .dock__item { position: relative; }
    .dock__app { display: block; border-radius: 10px; transition: transform .2s ease; transform-origin: bottom; }
    .dock__app img { width: 44px; height: 44px; border-radius: 10px; }
    .dock__app:focus-visible { outline-offset: 2px; }
    /* The name above the icon, like a dock's label */
    .dock__name {
      position: absolute;
      bottom: calc(100% + 14px);
      left: 50%;
      translate: -50% 4px;
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font: 13px/1.3 var(--font-term);
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity .15s ease, translate .15s ease;
    }
    .dock__app:is(:hover, :focus-visible) .dock__name { opacity: 1; translate: -50% 0; }
    .dock__item:hover .dock__app { transform: scale(1.18) translateY(-3px); }

    /* Open the site itself in a new tab: a badge on the icon's corner */
    .dock__out {
      position: absolute;
      top: -8px;
      right: -8px;
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border: 1px solid var(--term-border);
      border-radius: 50%;
      background: var(--surface);
      color: var(--text);
      opacity: 0;
      transition: opacity .15s ease;
    }
    .dock__out svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .dock__item:hover .dock__out, .dock__out:focus-visible { opacity: 1; }
    .dock__out:hover { background: var(--surface-raised); color: var(--text-strong); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock__item:hover .dock__app { transform: none; }
  }
</style>
