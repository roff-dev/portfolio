---
import type { HTMLAttributes } from 'astro/types';
import TitleBar from './TitleBar.astro';

interface Props extends HTMLAttributes<'div'> {
  /** Text in the title bar, e.g. kieron@portfolio:~/code */
  title: string;
  /** The larger hero shadow */
  raised?: boolean;
}

const { title, raised = false, class: className, ...attrs } = Astro.props;
---
<div class:list={['term', { 'term--raised': raised }, className]} {...attrs}>
  <TitleBar title={title} />
  <slot />
</div>

<style is:global>
  .term {
    width: 100%;
    background: var(--term-body);
    color: var(--text);
    border-radius: var(--radius-term);
    box-shadow: var(--shadow-term);
    overflow: hidden;
    font-family: var(--font-term);
  }
  .term--raised { box-shadow: var(--shadow-hero); }
  /* Windows 11 outlines every window with a hairline */
  [data-theme="windows"] .term { outline: 1px solid rgba(0, 0, 0, .1); outline-offset: -1px; }
  .prompt { margin: 0 0 10px; overflow-wrap: anywhere; }
  .prompt__user { color: var(--prompt-user); }
  .prompt__path { color: var(--prompt-path); }
  .prompt__ps { color: var(--text-2); }
</style>
